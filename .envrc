# .envrc — direnv per-directory environment
# ─────────────────────────────────────────────────────────────────────────────
# Automatically activates when you cd into this repo directory.
# Pins kubectl to the ai-sandbox kubeconfig for ALL commands in this shell,
# including any spawned by AI agents / GitHub Copilot terminal sessions.
#
# Setup (one-time):
#   brew install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc && source ~/.zshrc
#   direnv allow .          ← run from repo root
#
# To use the main kubeconfig explicitly (e.g. to reach ev-dev manually):
#   KUBECONFIG=~/.kube/config kubectl config use-context ev-dev
# ─────────────────────────────────────────────────────────────────────────────

export KUBECONFIG="$HOME/.kube/ai-sandbox/config"
