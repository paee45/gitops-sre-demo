# Service Dashboard environment variables
PORT=3000
NODE_ENV=production

# Dashboard authentication token
# Change this in production!
DASHBOARD_TOKEN=gitops-sre-demo-token-changeme

# Kubernetes configuration
# Leave empty to use in-cluster configuration (pod running in Kubernetes)
# KUBECONFIG=/path/to/kubeconfig

# For local testing:
# KUBECONFIG=~/.kube/config
