# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars — it is in .gitignore

aws_region              = "us-east-1"
instance_type           = "t3.medium"   # Upgrade to "t3.large" if OOM occurs
key_name                = ""            # e.g. "my-keypair"
allowed_ssh_cidr        = "0.0.0.0/0"  # Restrict to your IP: "1.2.3.4/32"
github_org              = "paee45"
github_repo             = "gitops-sre-demo"
tf_state_bucket         = "YOUR-TF-STATE-BUCKET"
tf_state_dynamodb_table = "terraform-state-lock"
project_name            = "gitops-sre-demo"
root_volume_size_gb     = 30
